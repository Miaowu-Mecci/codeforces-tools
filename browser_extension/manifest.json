{
  "manifest_version": 3,
  "name": "CF Submit Browser",
  "version": "0.1.3",
  "description": "Connect your server's cf-submit commands to a Codeforces session in this browser.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://codeforces.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
